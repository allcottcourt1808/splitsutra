# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Environment ──────────────────────────────────────────────────────────────
# Everything .env* is ignored EXCEPT the committed template.
# Firebase web config (VITE_FIREBASE_*) is a public identifier, not a secret — but
# .env.local can also pick up things that are, so the whole family stays out.
.env
.env.*
!.env.example

# ── Secrets — NFR-7 ──────────────────────────────────────────────────────────
# A committed Firebase Admin service-account key grants full database access and
# bypasses Security Rules entirely. Once it is in git history it is permanently
# compromised. These patterns are a backstop; `gitleaks` pre-commit is the primary
# guard (docs/10-deployment.md).
*-firebase-adminsdk-*.json
*.serviceaccount.json
*serviceAccount*.json
*service-account*.json
gcp-credentials.json

# ── Firebase / emulators ─────────────────────────────────────────────────────
.firebase/
.emulator-data/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
pubsub-debug.log*
ui-debug.log*

# ── Test output ──────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ── Editors / OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# ── Agent worktrees ──────────────────────────────────────────────────────────
# `git worktree` checkouts created for parallel agent runs. Each is a full copy of
# the repo plus its own node_modules, so `git add -A` from the root would otherwise
# offer to stage thousands of files from a sibling branch.
#
# Deliberately NOT `.claude/` wholesale: launch.json and skills/ are ordinary project
# config that may well be worth committing, and a blanket ignore is how they would
# quietly stop being an option.
#
# ⚠️ Removing one of these on Windows fails with "Filename too long" — the node_modules
# tree exceeds MAX_PATH. `git worktree prune` deregisters it; deleting the directory
# needs a long-path-aware tool.
.claude/worktrees/
