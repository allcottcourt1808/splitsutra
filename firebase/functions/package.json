{
  "name": "@splitsutra/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\"",
    "serve": "pnpm build && firebase emulators:start --only functions,firestore,auth",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@splitsutra/core": "workspace:*",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
}
