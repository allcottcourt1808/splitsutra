{
  // Deliberately self-contained rather than `"extends": "../../tsconfig.base.json"`.
  // The root base config is authored in Phase 01 by a different workstream; a
  // dangling `extends` is a hard tsc failure, not a warning. Switch to extending it
  // once it exists — the options below are the strict-mode settings docs/02 calls
  // for, so the switch should be a no-op.
  //
  // Runtime is Cloud Functions Gen 2 on nodejs24 (Active LTS). ESM ("type":"module"
  // in package.json) — every relative import therefore needs an explicit .js
  // extension, which is why the source below imports './common/config.js' and not
  // './common/config'.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "src",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // @splitsutra/core is not a declared dependency — see "//no-core-dependency" in
    // package.json — so there is no node_modules symlink for NodeNext to resolve the bare
    // specifier through. It is mapped straight at core's emitted declarations instead, which
    // is also why build-functions.mjs compiles core first: this file does not exist until it
    // has. The runtime half of the same decision is the esbuild alias in that script.
    "paths": {
      "@splitsutra/core": ["../../packages/core/dist/index.d.ts"],
    },
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib"],
}
