# -----------------------------------------------------------------------------
# SplitSutra — web app environment
#
# Copy to `.env.local` and fill in. `.env*` is gitignored; THIS file is not.
#
# READ THIS BEFORE TREATING THE FILE AS A SECRET STORE:
#
#   The Firebase *web* config is NOT a secret. It is a set of public identifiers,
#   exactly like a database hostname. Google ships it in the client bundle by design,
#   and anyone can read it out of the deployed JS in about ten seconds.
#
#   Security comes from Firestore Security Rules and App Check — never from hiding
#   these values (Article IV; docs/02-architecture.md §Environments;
#   docs/08-firebase-setup.md).
#
#   So: filling these in is not "committing credentials", and nobody should waste a
#   review cycle on it. But do NOT let that reasoning spread. Anything that IS a
#   secret — service-account JSON, an Admin SDK key, a Cloud Messaging server key,
#   an AdMob secret — must never appear in any `VITE_*` variable, because every
#   `VITE_*` variable is inlined into the public bundle at build time. Server-side
#   secrets belong in Cloud Functions config / Secret Manager, nowhere near here.
#
# `envPrefix` is set to `VITE_` in vite.config.ts, so only these reach the client.
# -----------------------------------------------------------------------------

# --- Firebase web app config -------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed once Firebase Analytics is enabled (Phase 09 onward).
VITE_FIREBASE_MEASUREMENT_ID=

# --- Local development -------------------------------------------------------
# `true` routes Auth/Firestore/Functions at the local emulator suite instead of a
# real project. Leave blank/false for `dev` and `prod` builds.
#
# The emulator host is hard-coded to 127.0.0.1 in core, NOT `localhost`: on Node 18+
# `localhost` can resolve to ::1 first and the emulators bind IPv4 only, which fails
# with a confusing timeout. See docs/08-firebase-setup.md.
VITE_USE_EMULATORS=false

# --- App Check (Phase 10) ----------------------------------------------------
# reCAPTCHA Enterprise site key. Public by design, same as the config above — a site
# key is meant to be read out of the page; its secret half stays in Google's console.
#
# Blank is a supported state: the client simply does not register, and `startApp()`
# reports the skip. Nothing enforces App Check yet, so the app runs either way.
#
# 🔴 A NEW key, created for App Check and registered under Firebase console -> App
#    Check -> Apps. NOT one of the "Key for Identity Platform reCAPTCHA integration"
#    keys this project already has for phone auth — each project carries three or four
#    of those under that single name, and using one here fails as
#    `appCheck/recaptcha-error` with nothing naming the key.
VITE_APPCHECK_SITE_KEY=

# reCAPTCHA cannot attest `localhost`, so a dev machine gets no token without a debug
# token. Set to `true` to have the SDK generate one and log it, then register that
# value in Firebase console -> App Check -> Apps -> Manage debug tokens.
#
# 🔴 A debug token is a COMPLETE App Check bypass for whoever holds it, against the
#    real project. It is read only when `import.meta.env.DEV` is true, so it is
#    dead-code-eliminated from any production build — but never paste one into a
#    `.env.production*` file, never commit it, and revoke it in the console when the
#    machine is done with it. Prefer one token per developer over a shared one.
VITE_APPCHECK_DEBUG_TOKEN=
