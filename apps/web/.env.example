# -----------------------------------------------------------------------------
# SplitSutra — web app environment
#
# Copy to `.env.local` and fill in. `.env*` is gitignored; THIS file is not.
#
# READ THIS BEFORE TREATING THE FILE AS A SECRET STORE:
#
#   The Firebase *web* config is NOT a secret. It is a set of public identifiers,
#   exactly like a database hostname. Google ships it in the client bundle by design,
#   and anyone can read it out of the deployed JS in about ten seconds.
#
#   Security comes from Firestore Security Rules and App Check — never from hiding
#   these values (Article IV; docs/02-architecture.md §Environments;
#   docs/08-firebase-setup.md).
#
#   So: filling these in is not "committing credentials", and nobody should waste a
#   review cycle on it. But do NOT let that reasoning spread. Anything that IS a
#   secret — service-account JSON, an Admin SDK key, a Cloud Messaging server key,
#   an AdMob secret — must never appear in any `VITE_*` variable, because every
#   `VITE_*` variable is inlined into the public bundle at build time. Server-side
#   secrets belong in Cloud Functions config / Secret Manager, nowhere near here.
#
# `envPrefix` is set to `VITE_` in vite.config.ts, so only these reach the client.
# -----------------------------------------------------------------------------

# --- Firebase web app config -------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed once Firebase Analytics is enabled (Phase 09 onward).
VITE_FIREBASE_MEASUREMENT_ID=

# --- Local development -------------------------------------------------------
# `true` routes Auth/Firestore/Functions at the local emulator suite instead of a
# real project. Leave blank/false for `dev` and `prod` builds.
#
# The emulator host is hard-coded to 127.0.0.1 in core, NOT `localhost`: on Node 18+
# `localhost` can resolve to ::1 first and the emulators bind IPv4 only, which fails
# with a confusing timeout. See docs/08-firebase-setup.md.
VITE_USE_EMULATORS=false

# --- App Check (Phase 10) ----------------------------------------------------
# reCAPTCHA Enterprise / v3 site key. Public by design, same as the config above.
# Leave blank until App Check is turned on.
VITE_APPCHECK_SITE_KEY=
