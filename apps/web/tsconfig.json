{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* This is the ONE package allowed to see the DOM. `packages/core` compiles with
       "lib": ["ES2022"] and no "DOM", which makes `window`/`document` a compile error
       there (Article II, checklists/phase-01-foundation.md §3). */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* No "baseUrl" on purpose. It is deprecated in TS 6 and stops functioning in TS 7
       (TS5101). The mappings below are already written relative to THIS file, which is
       how "paths" resolves when "baseUrl" is absent (TS >= 4.4) — so removing it changes
       nothing about resolution, and keeps the config valid for the TS 7 migration. */
    "paths": {
      "@/*": ["./src/*"],
      /* Resolve the workspace package to SOURCE, even though core now HAS a build
         (packages/core/tsconfig.build.json) and its package.json entry points name
         `dist`. Three reasons to keep the alias:
           1. `pnpm dev` works on a clean clone with nothing built yet.
           2. HMR crosses the package boundary — editing core refreshes the browser.
           3. It typechecks core's source a SECOND time, here under "bundler", while
              core's own build checks it under "NodeNext". A specifier only one of the
              two resolvers accepts therefore cannot land.
         firebase/functions deliberately does NOT do this: it consumes dist, the way
         Cloud Functions will at runtime. The matching alias lives in vite.config.ts. */
      "@splitsutra/core": ["../../packages/core/src/index.ts"],
      "@splitsutra/core/*": ["../../packages/core/src/*"],
    },
  },
  "include": ["src", "vite.config.ts"],
}
