{
  "name": "@splitsutra/core",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-agnostic core for SplitSutra: types, schemas, domain logic, repositories, hooks. No DOM, no react-dom, no react-native.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./domain": "./src/domain/index.ts",
    "./theme": "./src/theme/index.ts",
    "./utils": "./src/utils/index.ts",
    "./firebase": "./src/firebase/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./stores": "./src/stores/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
